# Copy this file to ".env" and fill it in. Never share or commit the real .env.

# --- Django basics -----------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
# Your domain(s), comma separated. Example: gongoni.example.org,localhost
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Needed when the site runs on https, example: https://gongoni.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=
# Leave empty to use a local SQLite file. For Postgres: postgres://user:pass@host:5432/dbname
DATABASE_URL=

# --- Mission details (shown on the thank-you page and in messages) ------------
MISSION_NAME=Gongoni Mission 27
TARGET_AMOUNT=3500
PAYBILL=7108831
ACCOUNT_TEXT=Mission Commitment
# A payment counts for the mission only if the account text it carries contains this word.
ACCOUNT_KEYWORD=mission
# The sender name of the M-Pesa messages on the treasurer's phone.
ALLOWED_SENDERS=MPESA

# --- Phone forwarder security -------------------------------------------------
# Long random string. The forwarder app must call:  https://YOUR-SITE/api/webhook/sms/?key=THIS_VALUE
WEBHOOK_SECRET=change-me-to-another-long-random-string

# --- Email (free, sent first) -------------------------------------------------
# "console" prints emails in the terminal (for testing). Use "smtp" for real sending.
EMAIL_BACKEND_MODE=console
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Gongoni 27 <no-reply@example.org>

# --- SMS (sent second) --------------------------------------------------------
# "console" prints SMS in the terminal (for testing). Use "africastalking" for real sending.
SMS_BACKEND=console
AT_USERNAME=sandbox
AT_API_KEY=
# Optional approved sender name, leave empty to use the default sender
AT_SENDER_ID=
# Send an SMS welcome message at registration too (costs SMS credit). The welcome email is always sent.
SEND_WELCOME_SMS=0
