DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,gongoni-mission-backend-xi.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://gongoni-27.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://gongoni-27.vercel.app,https://gongoni-mission-backend-xi.vercel.app
FRONTEND_URL=https://gongoni-27.vercel.app
BACKEND_URL=https://gongoni-mission-backend-xi.vercel.app
# Empty = local SQLite. Neon: postgresql://USER:PASSWORD@HOST-pooler.../neondb?sslmode=require&channel_binding=require
DATABASE_URL=

MISSION_NAME=Gongoni Mission 27
TARGET_AMOUNT=3500

# Paystack dashboard > Settings > API Keys & Webhooks
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_CURRENCY=KES
PAYSTACK_CALLBACK_URL=https://gongoni-27.vercel.app/payment/done
# Set the webhook URL in Paystack to: https://YOUR-BACKEND/api/paystack/webhook/

# "console" prints emails in the terminal, "smtp" really sends them
EMAIL_BACKEND_MODE=console
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Gongoni 27 <no-reply@example.org>
