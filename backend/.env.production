# PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to ".env" and fill in all the values marked as REQUIRED
# Never share or commit the real .env file with secrets
# Run this command to generate a secure random string: python -c "import secrets; print(secrets.token_urlsafe(32))"

# ==============================================================================
# DJANGO BASICS (REQUIRED)
# ==============================================================================

# REQUIRED: Django secret key - generate a long random string using the command above
# This secures sessions, CSRF tokens, and password reset links
DJANGO_SECRET_KEY=CHANGE-THIS-TO-A-LONG-RANDOM-STRING

# REQUIRED: Set to 0 for production, 1 for development
# In production, this must be 0 to hide error details and serve static files properly
DJANGO_DEBUG=0

# REQUIRED: Your domain name(s), comma separated
# Example: gongoni.example.org,www.gongoni.example.org
# Include localhost only for testing, remove for production
DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# REQUIRED: The HTTPS URL(s) of your site, comma separated
# This is needed for CSRF protection when using HTTPS
# Example: https://gongoni.example.org,https://www.gongoni.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# OPTIONAL: Database connection string
# Leave empty to use SQLite (simple, but file-based, not recommended for production)
# For production with a VPS that persists files, SQLite is acceptable
# For cloud platforms (Render, Railway, etc.) that delete files on restart, use Postgres:
# Format: postgres://username:password@host:port/database_name
# Example: postgres://gongoni:securepassword@db.example.com:5432/gongoni27
DATABASE_URL=

# ==============================================================================
# MISSION DETAILS (Customize as needed)
# ==============================================================================

# Display name of the mission (shown on thank-you page and in messages)
MISSION_NAME=Gongoni Mission 27

# Target amount per member in KES (used for percentage calculations)
TARGET_AMOUNT=3500

# M-Pesa Paybill number
PAYBILL=7108831

# Account text that members should use when paying
ACCOUNT_TEXT=Mission Commitment

# Keyword that must be present in the account text for a payment to count
# This filters out tithes and other payments on the same Paybill
ACCOUNT_KEYWORD=mission

# Sender name of M-Pesa messages on the treasurer's phone (usually "MPESA")
ALLOWED_SENDERS=MPESA

# ==============================================================================
# PHONE FORWARDER SECURITY (REQUIRED)
# ==============================================================================

# REQUIRED: Long random string for webhook security
# The forwarder app on the treasurer's phone will call:
# https://YOUR-SITE/api/webhook/sms/?key=THIS_VALUE
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=CHANGE-THIS-TO-ANOTHER-LONG-RANDOM-STRING

# ==============================================================================
# EMAIL CONFIGURATION (REQUIRED for production)
# ==============================================================================

# REQUIRED: Set to "smtp" for real email sending
# Set to "console" only for testing (emails print in terminal)
EMAIL_BACKEND_MODE=smtp

# SMTP server settings (Gmail example provided)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1

# REQUIRED: Your email credentials
# For Gmail, create an App Password at: https://myaccount.google.com/apppasswords
# Do NOT use your regular Gmail password - it will not work
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password-here

# REQUIRED: From address shown to recipients
DEFAULT_FROM_EMAIL=Gongoni 27 <your-email@gmail.com>

# Alternative email providers:
# Outlook/Hotmail: smtp.office365.com:587
# SendGrid: smtp.sendgrid.net:587
# Mailgun: smtp.mailgun.org:587

# ==============================================================================
# SMS CONFIGURATION (REQUIRED for production)
# ==============================================================================

# REQUIRED: Set to "africastalking" for real SMS sending
# Set to "console" for testing (SMS print in terminal)
# Set to "sandbox" to test without spending credit (messages not delivered)
SMS_BACKEND=africastalking

# REQUIRED: Africa's Talking credentials
# Sign up at: https://africastalking.com
# Check the price per SMS in your account before launch
AT_USERNAME=your-username
AT_API_KEY=your-api-key-here

# OPTIONAL: Approved sender name (takes time to approve, can add later)
# Leave empty to use the default sender ID
AT_SENDER_ID=

# OPTIONAL: Send SMS welcome message at registration (costs SMS credit)
# Set to 1 to enable, 0 to disable
# The welcome email is always sent regardless of this setting
SEND_WELCOME_SMS=0

# ==============================================================================
# ADVANCED SETTINGS (Optional)
# ==============================================================================

# Send notifications in background thread (recommended for production)
# Set to 1 to enable, 0 to disable
# Disable only if debugging notification issues
NOTIFY_ASYNC=1
