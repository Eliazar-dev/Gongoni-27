{
  "buildCommand": "bash build.sh",
  "outputDirectory": "backend/staticfiles",
  "installCommand": "python -m pip install -r requirements.txt",
  "framework": null,
  "rewrites": [
    {
      "source": "/static/:match*",
      "destination": "/backend/staticfiles/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
