{
  "version": 2,
  "builds": [
    {
      "src": "backend/gongoni/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.11"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/backend/staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/backend/gongoni/wsgi.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "gongoni.settings"
  }
}
