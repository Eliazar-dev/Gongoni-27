{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "backend/**",
      "excludeFiles": "{frontend/**,**/tests.py,backend/db.sqlite3}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__p=:path*" },
    { "source": "/static/:path*", "destination": "/frontend/dist/static/:path*" },
    { "source": "/assets/:path*", "destination": "/frontend/dist/assets/:path*" },
    { "source": "/sda-logos.png", "destination": "/frontend/dist/sda-logos.png" },
    { "source": "/(.*)", "destination": "/frontend/dist/index.html" }
  ]
}
