{
  "services": {
    "gongoni": {
      "root": ".",
      "framework": "python",
      "runtime": "python",
      "buildCommand": "cd backend && python manage.py collectstatic --noinput"
    }
  },
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/backend/staticfiles/$1"
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "gongoni"
      }
    }
  ]
}
