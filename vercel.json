{
  "buildCommand": "cd backend && pip install -r requirements.txt && python manage.py collectstatic --noinput",
  "outputDirectory": "backend/staticfiles",
  "installCommand": "cd backend && pip install -r requirements.txt",
  "framework": null,
  "rewrites": [
    {
      "source": "/static/:match*",
      "destination": "/backend/staticfiles/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
